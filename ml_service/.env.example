# Project API URL, not the Supabase dashboard/editor URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key used as the PostgREST apikey header for requests
# authenticated with each student's access token.
SUPABASE_KEY=your_publishable_key

# Server-only secret API key required to check PostgREST connectivity/schema.
# Never expose it to the frontend or commit it.
SUPABASE_SECRET_KEY=your_secret_api_key
